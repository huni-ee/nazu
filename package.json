{
  "name": "@huni_ee/nazu",
  "version": "0.1.0",
  "description": "Node.js library for building KakaoTalk bots with Arisa",
  "keywords": [
    "arisa",
    "kakao",
    "grpc",
    "typescript"
  ],
  "author": "huni-ee",
  "license": "Apache-2.0",
  "homepage": "https://nazu.huniee.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huni-ee/nazu.git"
  },
  "bugs": {
    "url": "https://github.com/huni-ee/nazu/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && tsc && vite build",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint src *.config.mjs",
    "prepare": "npm run build",
    "proto:generate": "protoc --proto_path=proto --proto_path=node_modules/protoc/include --ts_proto_out=src/grpc/generated --ts_proto_opt=env=node,forceLong=string,outputServices=grpc-js,outputClientImpl=false,outputJsonMethods=false,useOptionals=messages,oneof=unions,importSuffix=.js,fileSuffix=.pb proto/arisa.proto node_modules/protoc/include/google/protobuf/empty.proto",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig tsconfig.web.json",
    "docs": "typedoc"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7",
    "async-mutex": "^0.5.0",
    "axios": "^1.21.1",
    "axios-cookiejar-support": "^7.0.0",
    "better-sqlite3": "^13.1.1",
    "lossless-json": "^4.3.3",
    "mime-types": "^3.0.2",
    "tough-cookie": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/lucide": "1.2.154",
    "@iconify-json/mage": "1.2.4",
    "@iconify-json/material-symbols": "1.2.99",
    "@iconify-json/ri": "1.2.10",
    "@iconify-json/tabler": "1.2.45",
    "@iconify/utils": "^3.1.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "protoc": "^36.2.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "ts-proto": "^2.19.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
